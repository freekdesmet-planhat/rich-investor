# Copy to .env.local for local development, and set the same values in Netlify.

# --- Supabase (required) ---------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (required) ----------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL=

# --- Optional --------------------------------------------------------------
# When set, the daily job writes an AI news summary per watchlist stock.
# The app works fully without it and falls back to the provider's news feed.
ANTHROPIC_API_KEY=
# Used for the Buffett indicator's GDP series (section 5.20).
FRED_API_KEY=

# --- Market data -----------------------------------------------------------
# Override only to point at a self-hosted finance-query instance.
FINANCE_QUERY_BASE_URL=https://finance-query.com

# --- Auth (required) -------------------------------------------------------
# Comma-separated whitelist. Only these addresses can sign in; run
# scripts/sync-allowlist.ts after changing it, because the RLS policies read
# the allowed_users table rather than this variable.
ALLOWED_EMAILS=me@example.com,partner@example.com

# Absolute URL of the deployment, used for the magic-link redirect.
NEXT_PUBLIC_SITE_URL=https://your-app.netlify.app

# Exposed to the browser; same values as SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Email alerts ----------------------------------------------------------
# Fallback recipients, used until members save their own notification settings.
NOTIFY_EMAILS=me@example.com,partner@example.com
# Verified sender domain in Resend.
RESEND_FROM=Rich Investor <alerts@yourdomain.com>

# --- Nightly job ------------------------------------------------------------
# Shared secret for /api/cron/nightly-scan. Generate with: openssl rand -hex 32
# If unset, the endpoint is closed rather than open.
CRON_SECRET=
# Candidates the universe scan evaluates per nightly run.
SCAN_BATCH_SIZE=60

# --- AI summaries -----------------------------------------------------------
# Overrides the default model (claude-sonnet-5).
ANTHROPIC_MODEL=

# --- Analyst estimates ------------------------------------------------------
FMP_API_KEY=

# --- SEC EDGAR --------------------------------------------------------------
# EDGAR's access policy requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT="rich-investor-app/0.1 (you@example.com)"
